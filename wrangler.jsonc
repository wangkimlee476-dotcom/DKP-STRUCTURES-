{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dkp-structures",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "455fb135411f45ed814b43b0f74ce930"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CF_WORKER": "true",
    "SUPPORT_EMAIL": "dkpstructures@gmail.com",
    "SMARTSUPP_KEY": "784368b32262fad3ade23c88b4e9972d8c1c85e9",
    "TERMS_VERSION": "2026-11-10"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "previews": {
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "455fb135411f45ed814b43b0f74ce930"
      }
    ]
  }
}
