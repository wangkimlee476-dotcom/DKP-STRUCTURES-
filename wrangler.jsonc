{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dkp-structures",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "455fb135411f45ed814b43b0f74ce930"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "CF_WORKER": "true",
    "SUPPORT_EMAIL": "dkpstructures@gmail.com",
    "TERMS_VERSION": "2026-11-10"
  }
}
